<Window x:Class="Rewind.Preview.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Setup.Title}" Icon="Assets/Rewind.ico"
        Width="592" MinHeight="530" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="#1C1C1C" Foreground="#EBEBE8"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary Source="RewindTheme.xaml"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Background="{StaticResource Surface}" MouseLeftButtonDown="OnDragHeader">
                <DockPanel Margin="24,0,14,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource Setup.CloseInstaller}" ToolTip="{DynamicResource Setup.Close}" Click="OnClose">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/>
                    </Button>
                    <Image DockPanel.Dock="Left" Source="Assets/Rewind.png" Width="28" Height="28"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Rewind" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SetupVersion" Foreground="{StaticResource Muted}" FontSize="13"
                               VerticalAlignment="Center" Margin="10,2,0,0"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,20">
                <StackPanel x:Name="Options">
                    <TextBlock Text="{DynamicResource Setup.Heading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,17"/>
                    <TextBlock Text="{DynamicResource Setup.Language}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LanguagePicker" Margin="0,0,0,12" MinHeight="36" SelectionChanged="OnLanguageChanged"
                              AutomationProperties.Name="{DynamicResource Setup.Language}">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Русский" Tag="ru"/>
                    </ComboBox>

                    <TextBlock Text="{DynamicResource Setup.ProgramFolder}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="88" Content="{DynamicResource Setup.Browse}"
                                AutomationProperties.Name="{DynamicResource Setup.BrowseProgram}" Click="OnBrowseInstall"/>
                        <TextBox x:Name="InstallDirectory" MinHeight="36" AutomationProperties.Name="{DynamicResource Setup.ProgramFolder}"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource Setup.DataFolder}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="88" Content="{DynamicResource Setup.Browse}"
                                AutomationProperties.Name="{DynamicResource Setup.BrowseData}" Click="OnBrowseData"/>
                        <TextBox x:Name="DataDirectory" MinHeight="36" AutomationProperties.Name="{DynamicResource Setup.DataFolder}"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource Setup.ReplaysFolder}" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="88" Content="{DynamicResource Setup.Browse}"
                                AutomationProperties.Name="{DynamicResource Setup.BrowseReplays}" Click="OnBrowseReplays"/>
                        <TextBox x:Name="ReplaysDirectory" MinHeight="36" AutomationProperties.Name="{DynamicResource Setup.ReplaysFolder}"/>
                    </DockPanel>

                    <CheckBox x:Name="AutoStart" Content="{DynamicResource Setup.Autostart}"/>
                </StackPanel>

                <StackPanel x:Name="Complete" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Setup.Installed}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Setup.StartMenu}" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
                    <TextBlock x:Name="InstalledLocation" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                    Background="{StaticResource Surface}" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Content="{DynamicResource Setup.Cancel}" MinWidth="86" Margin="0,0,8,0"
                                IsCancel="True" Click="OnClose"/>
                        <Button x:Name="InstallButton" Content="{DynamicResource Setup.Install}" Style="{StaticResource PrimaryButton}"
                                MinWidth="112" IsDefault="True" Click="OnInstall"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
