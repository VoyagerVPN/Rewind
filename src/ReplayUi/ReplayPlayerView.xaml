<UserControl x:Class="Rewind.Preview.ReplayPlayerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rewind.Preview" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Background="#1C1C1C" Foreground="#EBEBE8" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Focusable="True" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RewindTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="PlayerMenuItem" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="PlayerPopupButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="PlayerSeekSeconds" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Width" Value="16"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
  <Grid Margin="12,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ClipTitleText" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <StackPanel x:Name="RecoveryNotice" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0" ToolTip="Плеер перезапущен. Можно продолжить просмотр."><ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="#8FBD92"/><TextBlock Text="Плеер восстановлен" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <ComboBox x:Name="MonitorClipPicker" Width="170" Visibility="Collapsed" SelectionChanged="OnMonitorClipSelected" AutomationProperties.Name="Экран повтора" Margin="8,2"/>
   </StackPanel>
   <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnClosePlayer" ToolTip="Закрыть плеер · Esc" AutomationProperties.Name="Закрыть плеер"><ui:SymbolIcon Symbol="Dismiss24" FontSize="19"/></Button>
  </Grid>
  <local:SixteenNineFrame Grid.Row="1"><Grid x:Name="VideoSurface" Background="Black"><Image x:Name="Poster" Stretch="Uniform" Opacity="0.65"/><local:NativeVideoView x:Name="Video" Visibility="Hidden" Clicked="OnVideoClicked"/><Grid x:Name="LoadingOverlay" Background="#80000000"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="180"><ui:ProgressRing x:Name="LoadingSpinner" Width="32" Height="32" IsIndeterminate="True" Margin="0,0,0,14" Foreground="{StaticResource Ink}"/><TextBlock x:Name="LoadingLabel" Text="Загрузка…" Foreground="{StaticResource Ink}" FontSize="13" HorizontalAlignment="Center"/></StackPanel></Grid>
   <Border x:Name="PlaybackErrorPanel" Visibility="Collapsed" Background="#F0181818" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="24" Margin="24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel><ui:SymbolIcon x:Name="PlaybackErrorIcon" Symbol="Warning24" FontSize="32" Foreground="#D9B47A" HorizontalAlignment="Center" Margin="0,0,0,14"/>
     <TextBlock x:Name="PlaybackErrorTitle" Text="Воспроизведение остановлено" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="PlaybackError" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
     <Button x:Name="RestartPlayerButton" Click="OnRestartPlayer" Margin="0,20,0,0" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="17"/><TextBlock Text="Перезапустить плеер" Margin="8,0,0,0"/></StackPanel></Button>
     <Button x:Name="FindAvailablePartButton" Content="Найти доступный фрагмент" Click="OnFindAvailablePart" Margin="0,10,0,0" HorizontalAlignment="Center"/>
     <Button x:Name="CancelRecoveryButton" Content="Отменить поиск" Click="OnCancelRecovery" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
   </Border>
  </Grid></local:SixteenNineFrame>
  <Grid Grid.Row="2" Margin="12,3,12,0"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions>
   <Slider x:Name="PositionSlider" Minimum="0" Maximum="8" ValueChanged="OnSeek" AutoToolTipPlacement="None" AutomationProperties.Name="Позиция воспроизведения"/>
   <local:TimelineRiskView x:Name="RiskRibbon" Height="3" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><ui:SymbolIcon x:Name="PlaybackHealthIcon" Symbol="Warning24" Visibility="Collapsed" FontSize="14" Foreground="#E5B54A" Margin="0,0,6,0" AutomationProperties.Name="В записи обнаружены ошибки"/><TextBlock x:Name="TimeText" Text="0:00 / 0:00" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PlayerStateText" FontSize="12" Margin="16,0,0,0" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="GoToStartButton" Click="OnGoToStart" Style="{StaticResource IconButton}" ToolTip="К началу видео" AutomationProperties.Name="К началу"><ui:SymbolIcon Symbol="Previous24" FontSize="20" Width="20" Height="20"/></Button>
     <Button x:Name="SeekBackwardButton" Click="OnSeekBackward" Style="{StaticResource IconButton}" Padding="4" Margin="2,0"><Grid Width="26" Height="26"><ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="26"/><TextBlock x:Name="SeekBackwardSeconds" Text="5" Style="{StaticResource PlayerSeekSeconds}"/></Grid></Button>
     <Button x:Name="PreviousFrameButton" Click="OnPreviousFrame" Style="{StaticResource IconButton}" ToolTip="Предыдущий кадр · Б / ," AutomationProperties.Name="Предыдущий кадр"><ui:SymbolIcon Symbol="ChevronLeft24" FontSize="20" Width="20" Height="20"/></Button>
     <Button x:Name="PlayButton" Click="OnPlay" Style="{StaticResource IconButton}" ToolTip="Пауза · пробел" AutomationProperties.Name="Пауза"><ui:SymbolIcon x:Name="PlayGlyph" Symbol="Pause24" FontSize="20" Width="20" Height="20"/></Button>
     <Button x:Name="NextFrameButton" Click="OnNextFrame" Style="{StaticResource IconButton}" ToolTip="Следующий кадр · Ю / ." AutomationProperties.Name="Следующий кадр"><ui:SymbolIcon Symbol="ChevronRight24" FontSize="20" Width="20" Height="20"/></Button>
     <Button x:Name="SeekForwardButton" Click="OnSeekForward" Style="{StaticResource IconButton}" Padding="4" Margin="2,0"><Grid Width="26" Height="26"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="26"/><TextBlock x:Name="SeekForwardSeconds" Text="5" Style="{StaticResource PlayerSeekSeconds}"/></Grid></Button>
     <Border Width="36" IsHitTestVisible="False"/>
    </StackPanel>
    <Grid Grid.Column="2" x:Name="AuxiliaryControlsHost"><Grid Width="387" MaxWidth="{Binding ActualWidth, ElementName=AuxiliaryControlsHost}" HorizontalAlignment="Right" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid x:Name="InlineTracks" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid VerticalAlignment="Center" ToolTip="Система"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Desktop24" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/><Slider x:Name="InlineSystemSlider" Grid.Column="1" MaxWidth="58" Value="{Binding Value, ElementName=SystemSlider, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=SystemSlider}" AutomationProperties.Name="Громкость системы в панели"/></Grid>
      <Grid Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Discord"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="People24" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/><Slider x:Name="InlineDiscordSlider" Grid.Column="1" MaxWidth="58" Value="{Binding Value, ElementName=DiscordSlider, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=DiscordSlider}" AutomationProperties.Name="Громкость Discord в панели"/></Grid>
      <Grid Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Микрофон"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Mic24" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/><Slider x:Name="InlineMicrophoneSlider" Grid.Column="1" MaxWidth="58" Value="{Binding Value, ElementName=MicrophoneSlider, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=MicrophoneSlider}" AutomationProperties.Name="Громкость микрофона в панели"/></Grid>
     </Grid>
     <Button x:Name="SoundButton" Grid.Column="1" Click="OnMixer" Style="{StaticResource PlayerPopupButton}" Tag="{Binding IsOpen, ElementName=MixerPopup}" ToolTip="Громкость дорожек" AutomationProperties.Name="Громкость дорожек"><ui:SymbolIcon Symbol="Speaker224" FontSize="20" Width="20" Height="20"/></Button>
     <Button x:Name="PlayerSettingsButton" Grid.Column="2" Click="OnPlayerSettings" Style="{StaticResource PlayerPopupButton}" Tag="{Binding IsOpen, ElementName=PlayerSettingsPopup}" ToolTip="Настройки плеера" AutomationProperties.Name="Настройки плеера"><ui:SymbolIcon Symbol="Settings24" FontSize="20" Width="20" Height="20"/></Button>
     <Button x:Name="ActionsButton" Grid.Column="3" Style="{StaticResource PlayerPopupButton}" Tag="{Binding IsOpen, ElementName=ActionsPopup}" Click="OnActions" ToolTip="Действия с клипом" AutomationProperties.Name="Действия с клипом"><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="20" Width="20" Height="20"/></Button>
    </Grid></Grid>
   </Grid>
  </Grid>
  <Popup x:Name="ActionsPopup" PlacementTarget="{Binding ElementName=ActionsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" Opened="OnActionsOpened"><Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Width="246" Margin="0,0,0,8" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14" TextElement.Foreground="{StaticResource Ink}"><Border.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RewindTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Border.Resources><StackPanel KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnActionsKeyDown">
   <Button x:Name="ShowClipInExplorerButton" Style="{StaticResource PlayerMenuItem}" Click="OnShowInExplorer"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="18"/><TextBlock Text="Показать в проводнике" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
   <Button x:Name="DeleteClipButton" Style="{StaticResource PlayerMenuItem}" Click="OnDeleteClip" Foreground="#E6A49B"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" FontSize="18"/><TextBlock Text="Удалить" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
  </StackPanel></Border></Popup>
  <Popup x:Name="PlayerSettingsPopup" PlacementTarget="{Binding ElementName=PlayerSettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="20" Width="360" Margin="0,0,0,8" TextElement.Foreground="{StaticResource Ink}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14">
   <Border.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RewindTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Border.Resources>
   <StackPanel>
   <TextBlock Text="Настройки плеера" Style="{StaticResource SettingsSectionTitle}" Margin="0,0,0,16"/>
   <CheckBox x:Name="PanelTracksToggle" Checked="OnPanelTracksChanged" Unchecked="OnPanelTracksChanged" AutomationProperties.Name="Показывать дорожки в панели"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Speaker224" Style="{StaticResource SettingsSectionIcon}"/><TextBlock Text="Дорожки в панели" VerticalAlignment="Center"/></StackPanel></CheckBox>
   <TextBlock Text="Система, Discord и микрофон" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,4,0,0"/>
   <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SymbolIcon Symbol="ArrowSwap24" Style="{StaticResource SettingsSectionIcon}"/><TextBlock Text="Перемотка" VerticalAlignment="Center"/></StackPanel>
    <ComboBox x:Name="SeekStepPicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnSeekStepChanged" AutomationProperties.Name="Шаг перемотки">
     <ComboBoxItem Tag="5" Content="5 секунд"/><ComboBoxItem Tag="10" Content="10 секунд"/><ComboBoxItem Tag="15" Content="15 секунд"/><ComboBoxItem Tag="30" Content="30 секунд"/>
    </ComboBox>
   </Grid>
   <TextBlock Text="Шаг для кнопок и горячих клавиш" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="30,6,0,0"/>
  </StackPanel></Border></Popup>
  <Popup x:Name="MixerPopup" PlacementTarget="{Binding ElementName=SoundButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20" Width="370" Margin="0,0,0,8"><StackPanel>
   <TextBlock Text="Звук" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="16"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <TextBlock Text="Общая" FontWeight="SemiBold" VerticalAlignment="Center"/><Slider x:Name="MasterSlider" Grid.Column="1" Value="25" ValueChanged="OnVolume" Tag="master" AutomationProperties.Name="Общая громкость"/><TextBlock x:Name="MasterValue" Grid.Column="2" Text="25%" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"/>
    <TextBlock Text="Система" Grid.Row="2" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="SystemSlider" Grid.Row="2" Grid.Column="1" Value="100" ValueChanged="OnVolume" Tag="0" AutomationProperties.Name="Громкость системы"/><TextBlock x:Name="SystemValue" Grid.Row="2" Grid.Column="2" Text="100%" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"/>
    <TextBlock Text="Discord" Grid.Row="3" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="DiscordSlider" Grid.Row="3" Grid.Column="1" Value="100" ValueChanged="OnVolume" Tag="1" AutomationProperties.Name="Громкость Discord"/><TextBlock x:Name="DiscordValue" Grid.Row="3" Grid.Column="2" Text="100%" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"/>
    <TextBlock Text="Микрофон" Grid.Row="4" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="MicrophoneSlider" Grid.Row="4" Grid.Column="1" Value="100" ValueChanged="OnVolume" Tag="2" AutomationProperties.Name="Громкость микрофона"/><TextBlock x:Name="MicrophoneValue" Grid.Row="4" Grid.Column="2" Text="100%" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"/>
   </Grid>
  </StackPanel></Border></Popup>
  <Popup x:Name="DeletePopup" PlacementTarget="{Binding ElementName=VideoSurface}" Placement="Center" StaysOpen="False" AllowsTransparency="True" Opened="OnDeletePopupOpened" Closed="OnDeletePopupClosed">
   <Border x:Name="DeleteConfirmation" Visibility="Collapsed" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="24" Width="400" TextElement.Foreground="{StaticResource Ink}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnDeletePopupKeyDown">
    <StackPanel><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" FontSize="22" Margin="0,0,12,0"/><TextBlock Text="Удалить клип?" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <TextBlock x:Name="DeleteFilenameText" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <TextBlock x:Name="DeleteScopeText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelDeleteButton" Click="OnCancelDelete" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Dismiss24" FontSize="17"/><TextBlock Text="Отмена" Margin="7,0,0,0"/></StackPanel></Button>
      <Button x:Name="ConfirmDeleteButton" Click="OnConfirmDelete" Background="#A83A35" Foreground="White"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" FontSize="17"/><TextBlock Text="Удалить" Margin="7,0,0,0"/></StackPanel></Button>
     </StackPanel>
    </StackPanel>
   </Border>
  </Popup>
  <Grid x:Name="RiskConfirmation" Grid.RowSpan="3" Visibility="Collapsed" Background="#EA141414" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="24" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
    <StackPanel Margin="24"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Warning24" FontSize="24" Foreground="#D9B47A" Margin="0,0,12,0"/><TextBlock Text="Открыть участок с ошибками?" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <TextBlock x:Name="RiskTargetText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,14,0,0"/>
     <TextBlock Text="В этой части записи уже возникали ошибки. Плеер может зависнуть или закрыться." FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16"><WrapPanel HorizontalAlignment="Right">
     <Button x:Name="ConfirmRiskButton" Click="OnConfirmRisk" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9" Margin="0,0,8,0" ToolTip="Попытаться открыть выбранное место, несмотря на возможный сбой"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="17" Foreground="#D9B47A"/><TextBlock Text="Открыть всё равно" Margin="7,0,0,0"/></StackPanel></Button>
     <Button x:Name="CancelRiskButton" Click="OnCancelRisk" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Dismiss24" FontSize="17"/><TextBlock Text="Отмена" Margin="7,0,0,0"/></StackPanel></Button>
     <Button x:Name="GoToSafePartButton" Click="OnGoToSafePart" Style="{StaticResource PrimaryButton}" Padding="12,9"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Next24" FontSize="17"/><TextBlock x:Name="SafePartLabel" Text="К доступному фрагменту" Margin="7,0,0,0"/></StackPanel></Button>
    </WrapPanel></Border>
   </StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
