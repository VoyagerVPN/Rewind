<UserControl x:Class="Rewind.Preview.TimeValueEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid MinWidth="64">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Button x:Name="Display" Click="OnEdit" Padding="8,5" ToolTip="{DynamicResource Ui.EnterExactTimeMSs}" FontWeight="SemiBold"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ValueText"/><ui:SymbolIcon Symbol="Edit24" FontSize="12" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/></StackPanel></Button>
  <TextBox x:Name="Input" Visibility="Collapsed" MinWidth="72" Padding="7,5" KeyDown="OnInputKey" LostKeyboardFocus="OnInputBlur" AutomationProperties.Name="{DynamicResource Ui.ExactTime}"/>
  <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" Foreground="#C47B74" FontSize="11" TextWrapping="Wrap" MaxWidth="160"/>
 </Grid>
</UserControl>
