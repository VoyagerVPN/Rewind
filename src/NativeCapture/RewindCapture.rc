#include <windows.h>
#include "BuildIdentity.h"
1 ICON "..\\..\\src\\ReplayUi\\Assets\\Rewind.ico"
1 VERSIONINFO
FILEVERSION REWIND_FILE_VERSION
PRODUCTVERSION REWIND_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Rewind Screen Capture"
      VALUE "ProductName", "Rewind"
      VALUE "FileVersion", REWIND_FILE_VERSION_STRING
      VALUE "ProductVersion", REWIND_PRODUCT_VERSION
      VALUE "InternalName", "Rewind.CaptureWorker"
      VALUE "OriginalFilename", "Rewind.CaptureWorker.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
